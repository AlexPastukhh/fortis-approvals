# P3.4 SOURCE REVIEW ONLY. Never build/run this as an automatic activation.
# The owner MUST pass a reviewed python:3.11-slim@sha256:<digest> base.
# No default base: a missing owner-pinned build argument fails the build.
ARG PYTHON_BASE
FROM ${PYTHON_BASE}
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
# No shell at runtime. Git is used only by the reviewed, data-only source reader.
RUN python3 -c "import sys; assert sys.version_info[:2] == (3,11)" \
    && apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10002 publisher \
    && useradd --uid 10002 --gid 10002 --no-create-home --shell /usr/sbin/nologin publisher
# Exact Python-only scope; not a Gateway server or a Repo checkout.
# Installed into system site-packages for python -I (no cwd/PYTHONPATH injection).
COPY fortis_approvals/__init__.py fortis_approvals/core.py fortis_approvals/diagnostic_contract.py fortis_approvals/repo_action_contract.py /usr/local/lib/python3.11/site-packages/fortis_approvals/
COPY fortis_approvals/clients/*.py /usr/local/lib/python3.11/site-packages/fortis_approvals/clients/
COPY fortis_approvals/workflow/*.py /usr/local/lib/python3.11/site-packages/fortis_approvals/workflow/
COPY fortis_approvals/integrations/*.py /usr/local/lib/python3.11/site-packages/fortis_approvals/integrations/
COPY fortis_approvals/integrations/github/*.py /usr/local/lib/python3.11/site-packages/fortis_approvals/integrations/github/
COPY fortis_approvals/integrations/github/repo_client/*.py /usr/local/lib/python3.11/site-packages/fortis_approvals/integrations/github/repo_client/
# No owner API/Portal, GitHub PAT, machine grant, validator code, PR source,
# Repo worktrees, config, journal, network routing, mount or timer in image.
USER 10002:10002
WORKDIR /opt/fortis-publisher
STOPSIGNAL SIGTERM
ENTRYPOINT ["python3", "-I", "-B", "-m", "fortis_approvals.integrations.github.release_label_publisher"]
# Owner must run with --read-only, --cap-drop=ALL, no-new-privileges,
# host-enforced Gateway-only egress and exact readonly trusted mounts.

# SOURCE CANDIDATE ONLY. Not built, approved, or deployed.
# Preserves the current Sonar R7 runtime while packaging provider integrations.
# GitHub adapter is source-present but NOT registered, granted, or credentialed.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/fortis
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY fortis_approvals/requirements-owner.txt /opt/requirements-owner.txt
RUN python -m pip install --disable-pip-version-check --no-cache-dir -r /opt/requirements-owner.txt && \
    groupadd -g 10001 fortis && \
    useradd --no-log-init -u 10001 -g 10001 -M -s /usr/sbin/nologin fortis
RUN mkdir -p /opt/fortis/fortis_approvals/static /opt/fortis/fortis_approvals/integrations/sonarcloud/gateway /opt/fortis/fortis_approvals/integrations/github/gateway /state /run/r7-identity /run/r7-grant /run/r7-sonar-token
COPY fortis_approvals/__init__.py fortis_approvals/core.py fortis_approvals/owner_auth.py fortis_approvals/owner_portal.py fortis_approvals/owner_shell.py fortis_approvals/owner_shell_portal.py fortis_approvals/incidents.py fortis_approvals/repo_action_contract.py fortis_approvals/repo_ingress.py fortis_approvals/r5_read_candidate.py fortis_approvals/r5_read_server.py fortis_approvals/r7_unified_candidate.py fortis_approvals/r7_unified_server.py fortis_approvals/a3_server.py fortis_approvals/server.py /opt/fortis/fortis_approvals/
# All reviewed provider packages and the extension runtime are packaged once.
COPY fortis_approvals/integrations/ /opt/fortis/fortis_approvals/integrations/
COPY fortis_approvals/extensions/ /opt/fortis/fortis_approvals/extensions/
COPY fortis_approvals/clients/ /opt/fortis/fortis_approvals/clients/
COPY fortis_approvals/workflow/__init__.py fortis_approvals/workflow/common.py fortis_approvals/workflow/store.py fortis_approvals/workflow/git_backend.py fortis_approvals/workflow/adapters.py fortis_approvals/workflow/ingress.py fortis_approvals/workflow/runtime.py /opt/fortis/fortis_approvals/workflow/
COPY fortis_approvals/static /opt/fortis/fortis_approvals/static
COPY fortis_approvals/deploy/github_pilot_helpers.py /opt/fortis/operator/state_helpers.py
COPY fortis_approvals/deploy/image_offline_smoke.py /opt/fortis/operator/image_smoke.py
USER 10001:10001
EXPOSE 19103 19104
CMD ["python","-m","fortis_approvals.r7_unified_server"]
